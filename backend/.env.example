APP_ENV=local
APP_NAME=VitaiWorld API
POSTGRES_USER=vitai
POSTGRES_PASSWORD=vitai
POSTGRES_DB=vitai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SECRET_KEY=change-me-0123456789abcdef0123456789abcdef
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-password
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=[]
ENABLE_HTTPS_REDIRECT=false
# ENABLE_DOCS — необязательная переменная: явный true/false включает/выключает
# /docs, /redoc, /openapi.json. Без неё: включено вне production, выключено в production.
LOG_LEVEL=INFO
SQL_ECHO=false
LEAD_DEDUP_WINDOW_MINUTES=10
TELEGRAM_BOT_TOKEN=
