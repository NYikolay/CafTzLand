# Production-окружение. Скопировать в .env.prod (git-ignored) и заполнить.
# Запуск: docker compose --env-file .env.prod -f compose.prod.yaml up -d --build

# --- Postgres (db/migrate/backend) ---
POSTGRES_USER=kvarta
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=kvarta
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=production
APP_NAME=VitaiWorld API
# Оба секрета сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_USERNAME=admin
# openssl rand -base64 24
ADMIN_PASSWORD=change-me-strong-password
# Домены/IP, с которых принимаются запросы (TrustedHostMiddleware)
# "backend" — BFF/nginx (Host: backend:8000); "127.0.0.1" — HEALTHCHECK-проба образа
ALLOWED_HOSTS=["tzkvvit.site","www.tzkvvit.site","178.172.161.15","localhost","127.0.0.1","backend"]
CORS_ORIGINS=[]
# false: TLS терминирует nginx (default.conf делает 301 http→https);
# true несовместим с plain-HTTP HEALTHCHECK контейнера (Starlette middleware, scheme-based).
ENABLE_HTTPS_REDIRECT=false
LOG_LEVEL=INFO
SQL_ECHO=false
LEAD_DEDUP_WINDOW_MINUTES=10
# Токен телеграм-бота; пусто = уведомления о заявках выключены
TELEGRAM_BOT_TOKEN=

# --- Frontend ---
# Публичный URL (canonical/OG/sitemap): build arg + runtime
NEXT_PUBLIC_SITE_URL=https://tzkvvit.site

# --- Порты nginx (опционально; дефолты 80/443) ---
# HTTP_PORT=80
# HTTPS_PORT=443
